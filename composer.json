{
  "name": "watermoss/watermossmc",
  "description": "Watermoss — Minimal Minecraft Bedrock server (PHP, MVP offline-mode)",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "ext-sockets": "*",
    "ext-openssl": "*",
    "ext-zlib": "*"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "Watermoss\\": "src/"
    }
  }
}
